{
	"name": "obsidian-in-the-open",
	"version": "0.1.0",
	"description": "Publish a note to your website over Micropub, with its links turned into real citations.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run --passWithNoTests"
	},
	"keywords": [
		"obsidian",
		"micropub",
		"citations",
		"pandoc"
	],
	"author": "Jorrit van der Heide",
	"license": "EUPL-1.2",
	"devDependencies": {
		"obsidian-citation-core": "file:../obsidian-citation-core",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "~1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^3.2.7"
	}
}
